// Radius.Data/sqlServerDatabases recipe for a local Kubernetes cluster (Docker Desktop).
// Runs SQL Server 2022 Developer edition as a single-replica Deployment with a persistent volume.
// SQL Server containers only expose the built-in `sa` login, so the resource's `username` must be `sa`;
// the resource's `password` becomes the SA password and must meet SQL Server complexity rules.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('SQL Server container image.')
param image string = 'mcr.microsoft.com/mssql/server:2022-latest'

@description('Size of the persistent volume holding the SQL Server data files.')
param storageSize string = '5Gi'

@description('Storage class for the data volume. Empty uses the cluster default (hostpath on Docker Desktop).')
param storageClassName string = ''

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var resourceName = toLower(context.resource.name)
var namespace = context.runtime.kubernetes.namespace
var database = context.resource.properties.?database ?? 'appdb'
var port = 1433
var labels = {
  'radapp.io/resource': context.resource.name
  'radapp.io/application': context.application != null ? context.application.name : ''
  'radapp.io/environment': context.environment != null ? context.environment.name : ''
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
}

resource credentials 'core/Secret@v1' = {
  metadata: {
    name: '${resourceName}-credentials'
    namespace: namespace
    labels: labels
  }
  stringData: {
    MSSQL_SA_PASSWORD: context.resource.properties.password
  }
}

resource data 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${resourceName}-data'
    namespace: namespace
    labels: labels
  }
  spec: union(
    {
      accessModes: [
        'ReadWriteOnce'
      ]
      resources: {
        requests: {
          storage: storageSize
        }
      }
    },
    empty(storageClassName) ? {} : { storageClassName: storageClassName }
  )
}

resource sqlServer 'apps/Deployment@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    replicas: 1
    strategy: {
      // Two SQL Server instances must never share the same data volume.
      type: 'Recreate'
    }
    selector: {
      matchLabels: {
        'radapp.io/resource': context.resource.name
      }
    }
    template: {
      metadata: {
        labels: labels
      }
      spec: {
        securityContext: {
          fsGroup: 10001
        }
        containers: [
          {
            name: 'mssql'
            image: image
            ports: [
              {
                name: 'tds'
                containerPort: port
              }
            ]
            env: [
              {
                name: 'ACCEPT_EULA'
                value: 'Y'
              }
              {
                name: 'MSSQL_PID'
                value: 'Developer'
              }
              {
                name: 'MSSQL_SA_PASSWORD'
                valueFrom: {
                  secretKeyRef: {
                    name: credentials.metadata.name
                    key: 'MSSQL_SA_PASSWORD'
                  }
                }
              }
            ]
            resources: {
              requests: {
                cpu: '500m'
                memory: '2Gi'
              }
              limits: {
                memory: '3Gi'
              }
            }
            readinessProbe: {
              exec: {
                command: [
                  '/bin/sh'
                  '-c'
                  '/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C -Q "SELECT 1" -b -o /dev/null'
                ]
              }
              initialDelaySeconds: 15
              periodSeconds: 10
              timeoutSeconds: 5
            }
            volumeMounts: [
              {
                name: 'data'
                mountPath: '/var/opt/mssql'
              }
            ]
          }
        ]
        volumes: [
          {
            name: 'data'
            persistentVolumeClaim: {
              claimName: data.metadata.name
            }
          }
        ]
      }
    }
  }
}

resource service 'core/Service@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      'radapp.io/resource': context.resource.name
    }
    ports: [
      {
        name: 'tds'
        port: port
        targetPort: 'tds'
      }
    ]
  }
}

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${credentials.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${data.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${sqlServer.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${service.metadata.name}'
  ]
  values: {
    host: '${service.metadata.name}.${namespace}.svc.cluster.local'
    port: port
    database: database
  }
}
