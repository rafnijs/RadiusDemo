// Radius.Compute/containers recipe for a local Kubernetes cluster (Docker Desktop).
// Creates a Deployment plus a Service. The default LoadBalancer Service type makes Docker Desktop
// publish the container ports on localhost, so the app is reachable at http://localhost:<servicePort>.

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Kubernetes Service type. LoadBalancer publishes the ports on localhost in Docker Desktop.')
@allowed([
  'LoadBalancer'
  'NodePort'
  'ClusterIP'
])
param serviceType string = 'LoadBalancer'

@description('Port published by the Service for the first container port. Additional ports keep their container port.')
param servicePort int = 8090

@description('Image pull policy. IfNotPresent reuses images already in the Docker Desktop image store.')
param imagePullPolicy string = 'IfNotPresent'

@description('Non-root UID for the pod. 1654 is the "app" user in the .NET base images.')
param runAsUser int = 1654

extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

var resourceName = toLower(context.resource.name)
var namespace = context.runtime.kubernetes.namespace
var properties = context.resource.properties
var containerItems = items(properties.containers)
var labels = {
  'radapp.io/resource': context.resource.name
  'radapp.io/application': context.application != null ? context.application.name : ''
  'radapp.io/environment': context.environment != null ? context.environment.name : ''
}

// Connected resources surface their non-sensitive properties as CONNECTION_<NAME>_<PROPERTY>.
// Sensitive properties are redacted to null on reads, so null values are skipped.
var excludedConnectionProperties = ['recipe', 'secrets', 'status', 'provisioningState', 'environment', 'application', 'connections', 'password']
var connectionEnv = reduce(items(context.resource.?connections ?? {}), [], (acc, conn) => concat(acc, reduce(
  items(conn.value.?properties ?? {}),
  [],
  (envAcc, prop) => (contains(excludedConnectionProperties, prop.key) || prop.value == null)
    ? envAcc
    : concat(envAcc, [{
        name: toUpper('CONNECTION_${conn.key}_${prop.key}')
        value: string(prop.value)
      }])
)))

var containers = map(containerItems, item => {
  name: toLower(item.key)
  image: item.value.image
  imagePullPolicy: imagePullPolicy
  // Secret-backed variables first so plain values can reference them with $(VAR).
  env: concat(
    map(filter(items(item.value.?env ?? {}), e => e.value.?valueFrom.?secretKeyRef != null), e => {
      name: e.key
      valueFrom: {
        secretKeyRef: {
          // Radius.Security/secrets resources are materialized as Kubernetes Secrets with the same name.
          name: e.value.valueFrom.secretKeyRef.secretName
          key: e.value.valueFrom.secretKeyRef.key
        }
      }
    }),
    map(filter(items(item.value.?env ?? {}), e => e.value.?value != null), e => {
      name: e.key
      value: string(e.value.value)
    }),
    filter(connectionEnv, c => !contains(item.value.?env ?? {}, c.name))
  )
  ports: map(items(item.value.?ports ?? {}), p => {
    name: toLower(p.key)
    containerPort: p.value.containerPort
    protocol: p.value.?protocol ?? 'TCP'
  })
  securityContext: {
    allowPrivilegeEscalation: false
    capabilities: {
      drop: [
        'ALL'
      ]
    }
  }
  resources: {
    requests: {
      cpu: '100m'
      memory: '256Mi'
    }
    limits: {
      cpu: '1'
      memory: '512Mi'
    }
  }
})

var allPorts = flatten(map(containerItems, item => map(items(item.value.?ports ?? {}), p => {
  name: toLower(p.key)
  containerPort: p.value.containerPort
})))

resource deployment 'apps/Deployment@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    replicas: properties.?replicas ?? 1
    selector: {
      matchLabels: {
        'radapp.io/resource': context.resource.name
      }
    }
    template: {
      metadata: {
        labels: labels
      }
      spec: {
        enableServiceLinks: false
        securityContext: {
          runAsNonRoot: true
          runAsUser: runAsUser
          runAsGroup: runAsUser
          seccompProfile: {
            type: 'RuntimeDefault'
          }
        }
        containers: containers
      }
    }
  }
}

resource service 'core/Service@v1' = if (!empty(allPorts)) {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: serviceType
    selector: {
      'radapp.io/resource': context.resource.name
    }
    ports: [for (p, i) in allPorts: {
      name: p.name
      port: i == 0 ? servicePort : p.containerPort
      targetPort: p.containerPort
    }]
  }
}

output result object = {
  resources: concat(
    [
      '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${deployment.metadata.name}'
    ],
    empty(allPorts) ? [] : [
      '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${resourceName}'
    ]
  )
  values: {}
}
