@page
@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

<div class="row g-5">
    <div class="col-md-7">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.CustomerName" class="form-label"></label>
                <input asp-for="Input.CustomerName" class="form-control" />
                <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Address" class="form-label"></label>
                <textarea asp-for="Input.Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>
            <button class="btn btn-success btn-lg">Place order</button>
        </form>
    </div>
    <div class="col-md-5">
        <h2 class="h5">Order summary</h2>
        <ul class="list-group mb-3">
            @foreach (var line in Model.Lines)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@line.Quantity × @line.Name</span>
                    <span>@Format.Money(line.LineTotal)</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between fw-bold">
                <span>Total</span><span>@Format.Money(Model.Total)</span>
            </li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
